# Spring backend API base URL used by the browser client.
# Default when unset: http://localhost:8080/api/v1
# Use /api/v1 to route through the Vite dev-server proxy (vite.config.ts) instead of CORS.
# Setting /api/v1 changes request URLs: the mocked e2e/smoke.spec.ts and
# integrated.spec.ts route patterns and the e2e/fixtures.ts allow-list assume the
# default http://localhost:8080/api/v1, so they apply only with the default.
VITE_API_BASE_URL=http://localhost:8080/api/v1
